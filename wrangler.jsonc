{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dentalog",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Patient records. Create with `npx wrangler d1 create dentalog` and paste the id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dentalog",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // X-rays, photos, consent forms and letterheads. Create with `npx wrangler r2 bucket create dentalog-files`.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "dentalog-files" }
  ],
  // Every night at 02:00 IST (20:30 UTC): permanently remove items deleted more than 30 days ago.
  "triggers": { "crons": ["30 20 * * *"] },
  "observability": { "enabled": true }
}
